# kista-api 도메인 라우팅 — kista-api 레포 소유. kista-infra reconcile.sh가 config SHA의 이 파일을 /opt/kista-infra/routes/kista-api.caddy에 설치하고
# caddy reload한다(kista-infra Caddyfile이 `import /etc/caddy/routes/...`로 읽음). upstream 공용 설정(keepalive off·lb_try·health 주기)은
# kista-infra Caddyfile의 `(upstream)`·`(upstream-stop-first)` snippet이 소유한다 — 여기서는 `import <snippet> <health_uri>`만 쓴다.
# kista-web(blue/green)은 `upstream`(lb_try 120초), kista-worker(단일·stop-first, 재시작 3~4분)는 `upstream-stop-first`(5초)다.
# 라우팅이 컨트롤러 경로와 어긋나 404가 나던 사고(2026-09-16 2단 경로, 2026-09-17 fida-orders)를 막기 위해
# CaddyRoutingTest가 아래 @scheduler·@trading regex를 엔진(worker)·비엔진(web) 컨트롤러 경로와 대조한다(RoleRoutingGuard와 같은 분류) — 경로 추가 시 테스트가 알려준다.
{$API_DOMAIN}, http://:8080 {
	# 공용 보안 헤더·접근 로그(/data/access/kista-api.log) — kista-infra Caddyfile의 (site) snippet 소유. 상태 코드 없는 handle_errors를 여기 두면 (site)와 겹친다.
	# 엔진 handle은 `vars engine 1`을 심는다 — 아래 handle_errors가 matcher를 다시 적지 않고 이 값으로 엔진 대역을 가른다
	import site kista-api
	encode zstd gzip
	# 스케쥴러 수동 트리거 — `/**`는 2단 이상 깊이(kbland-price-index/full-refresh)에서 매치 실패해 kista-web으로 새던 것을 path_regexp로 교체(2026-10-01 실측)
	@scheduler path_regexp ^/api/admin/scheduler/.+$
	handle @scheduler {
		vars engine 1
		reverse_proxy kista-worker:8080 {
			import upstream-stop-first /actuator/health/liveness
		}
	}
	# 엔진 공개 경로(kista-worker) — 여기서 빠지면 kista-web이 RoleRoutingGuard로 503. path matcher의 `**`는 2단 이상 깊이에서 매치 실패(caddy v2.9.1 실측)라 path_regexp 사용.
	# /api/stats는 kista-web(housing-benchmark)과 kista-worker(summary/equity-curve/cycles)이 prefix를 공유해 하위 경로로만 가른다.
	# /api/internal/** 중 외부(FIDA)가 공인 도메인으로 호출하는 fida-orders만 여기로 — 나머지 internal은 kista-web이 내부망으로 직접 호출
	@trading path_regexp ^/api/(trading-cycles(/.*)?|accounts(/.*)?|backtest|daily-trades|orders(/.*)?|stats/(summary|equity-curve|cycles)|internal/fida-orders)$
	handle @trading {
		vars engine 1
		reverse_proxy kista-worker:8080 {
			import upstream-stop-first /actuator/health/liveness
		}
	}
	handle {
		reverse_proxy kista-web:8080 {
			import upstream /actuator/health/liveness
		}
	}
	# kista-worker 재시작 중(Caddy가 만든 502·503·504만 — worker가 직접 낸 5xx는 그대로 지나간다) 엔진 경로에 안내 본문을 준다.
	# 상태 코드를 단 handle_errors가 (site)의 것보다 먼저 매치되고 respond가 거기서 끝나므로 보안 헤더를 여기서 다시 건다
	# (빼면 엔진 503에 HSTS 등이 빠지고 Server 헤더가 남는다 — caddy 2.11.9 실측 2026-11-24). 비엔진 경로의 502~504는 본문 없이 (site)로 넘어간다
	handle_errors 502 503 504 {
		import site-headers
		@engine vars engine 1
		handle @engine {
			header Content-Type application/problem+json
			header Retry-After 30
			respond `{"type":"about:blank","title":"Engine Restarting","status":503,"detail":"매매 서버를 재시작하는 중입니다. 잠시 후 다시 시도해 주세요.","code":"ENGINE_RESTARTING"}` 503
		}
	}
}

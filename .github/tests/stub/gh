#!/usr/bin/env bash
# wait-reconcile.bats용 gh 스텁 — STUB_RUN_ID(빈값이면 run 미발견), STUB_CONCLUSION, STUB_WATCH_RC, STUB_NEWER(더 새 같은 앱 run 수), STUB_WATCH_SLEEP(watch 지연 초), STUB_STATUS(run status)
echo "gh $*" >> "${GH_LOG:?}"
case "$1 $2" in
  "run list") if [[ "$*" == *startswith* ]]; then echo "${STUB_NEWER:-0}"; else echo "${STUB_RUN_ID:-}"; fi ;;
  "run watch") sleep "${STUB_WATCH_SLEEP:-0}"; exit "${STUB_WATCH_RC:-0}" ;;
  "run view") if [[ "$*" == *"json status"* ]]; then echo "${STUB_STATUS:-completed}"; else echo "${STUB_CONCLUSION:-success}"; fi ;;
esac

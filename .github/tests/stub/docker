#!/usr/bin/env bash
# bats용 docker 스텁 — 호출을 $DOCKER_LOG에 남기고 STUB_* 환경변수로 응답을 정한다
echo "docker $*" >> "${DOCKER_LOG:?}"
case "$1 $2" in
  "ps -q") echo "${STUB_CADDY_ID:-}" ;;
  "inspect -f") echo "${STUB_PREV_IMAGE:-}" ;;
  "inspect --format") echo "${STUB_HEALTH:-healthy}" ;;
  "exec "*)
    if [ "$3" = "caddy" ]; then exit "${STUB_CADDY_RELOAD_RC:-0}"; fi
    if [ "$3" = "wget" ]; then exit "${STUB_READY_RC:-0}"; fi
    if [ "$3" = "psql" ]; then echo "${STUB_LOCKS:-}"; exit "${STUB_PSQL_RC:-0}"; fi ;;
esac
exit 0
